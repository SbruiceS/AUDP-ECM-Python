"""Type stubs for the compiled extension (use the public `audp_ecm` API)."""

from typing import List, Optional, Tuple

__version__: str
MAX_INPUT_BYTES: int
MAX_DEPTH: int

class EcmError(Exception): ...
class ConfigError(EcmError): ...
class InputLengthError(EcmError): ...
class ErasureIndexError(EcmError): ...
class DecodeError(EcmError): ...

def gf_mul(a: int, b: int) -> int: ...
def gf_inv(a: int) -> int: ...
def gf_pow(a: int, e: int) -> int: ...
def crc16(data: bytes) -> int: ...
def append_crc16(data: bytes) -> bytes: ...
def verify_crc16(frame: bytes) -> bytes: ...
def interleave_codewords(codewords: List[bytes]) -> bytes: ...
def deinterleave_codewords(data: bytes, depth: int) -> List[bytes]: ...
def mark_erasures(reliability: List[float], threshold: float, max_erasures: Optional[int] = None) -> List[int]: ...

class DecodeResult:
    @property
    def data(self) -> bytes: ...
    @property
    def corrected_symbols(self) -> int: ...
    @property
    def erasures(self) -> int: ...
    @property
    def verified(self) -> bool: ...

class ReedSolomon:
    def __init__(self, n: int, k: int) -> None: ...
    @property
    def n(self) -> int: ...
    @property
    def k(self) -> int: ...
    @property
    def t(self) -> int: ...
    def encode(self, data: bytes) -> bytes: ...
    def decode(self, received: bytes, erasures: List[int] = ...) -> DecodeResult: ...
    def decode_euclidean(self, received: bytes, erasures: List[int] = ...) -> DecodeResult: ...
    def syndromes(self, received: bytes) -> bytes: ...
    def is_codeword(self, word: bytes) -> bool: ...

class BurstCodec:
    def __init__(self, n: int, k: int, depth: int) -> None: ...
    @staticmethod
    def depth_for(n: int, k: int, payload_len: int, burst_len: int) -> int: ...
    @property
    def depth(self) -> int: ...
    @property
    def capacity(self) -> int: ...
    @property
    def encoded_len(self) -> int: ...
    @property
    def burst_tolerance(self) -> int: ...
    def protect(self, payload: bytes) -> bytes: ...
    def recover(self, received: bytes, erasures: List[int] = ...) -> bytes: ...

class BchCode:
    def __init__(self, n: int, t: int) -> None: ...
    @property
    def n(self) -> int: ...
    @property
    def k(self) -> int: ...
    @property
    def t(self) -> int: ...
    def encode(self, data_bits: List[bool]) -> List[bool]: ...
    def decode(self, received_bits: List[bool]) -> List[bool]: ...

class SymbolErrorChannel:
    def __init__(self, p: float) -> None: ...
    @property
    def p(self) -> float: ...
    def corrupt(self, data: bytes, seed: int) -> bytes: ...

class BurstErrorChannel:
    def __init__(self, p_start: float, p_continue: float) -> None: ...
    @property
    def mean_burst_length(self) -> float: ...
    def corrupt(self, data: bytes, seed: int) -> bytes: ...

class ErasureChannel:
    def __init__(self, p: float) -> None: ...
    def corrupt(self, data: bytes, seed: int) -> Tuple[bytes, List[int]]: ...
